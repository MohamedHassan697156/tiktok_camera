<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application>
        <!-- Render with Impeller's OpenGL ES backend in debug builds only.
             Emulator graphics drivers (LDPlayer, and some AVD configurations)
             cannot import the camera's AHardwareBuffer into Vulkan and fail with
             "Could not create image for external buffer", which leaves the preview
             a black rectangle. OpenGL ES takes a path those drivers do support.

             Release builds keep Impeller's default Vulkan backend, which is the
             faster path on real hardware. If a preview is black on an emulator,
             this is the flag to reach for. -->
        <meta-data
            android:name="io.flutter.embedding.android.ImpellerBackend"
            android:value="opengles" />
    </application>
</manifest>
